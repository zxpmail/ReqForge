{
  "name": "reqforge",
  "version": "1.20.0",
  "description": "Open-source product development framework for AI coding assistants (Claude Code/Cursor/OpenCode)",
  "scripts": {
    "sync": "ts-node scripts/sync.ts",
    "forge-install": "ts-node scripts/install.ts",
    "dep-graph": "ts-node scripts/dependency-graph.ts",
    "validate-skill": "node scripts/validate-skill.mjs",
    "validate-skill:bash": "bash scripts/validate-skill.sh",
