{
  "version": 1,
  "skill": "feedback-writer",
  "description": "Output quality — after a manual or agent run, place artifacts under artifacts_root then run pnpm skill-eval",
  "artifacts_root": "eval-output",
  "cases": [
    {
      "id": "user-correction-record",
      "split": "train",
      "prompt": "用户纠正：Agent 在 dev-builder Phase 3 中跳过了 lint 步骤，用户指出后修正。需要记录反馈。",
      "artifacts_subdir": "user-correction-record",
      "assertions": {
        "fileExists": [
          "feedback/skip-lint-in-dev-builder.md",
          "feedback/FEEDBACK-INDEX.md"
        ],
        "maxBytes": [
          { "file": "feedback/skip-lint-in-dev-builder.md", "max": 10000 }
        ],
        "regexChecks": [
          {
            "id": "has-scores",
            "file": "feedback/skip-lint-in-dev-builder.md",
            "mustMatch": "Precision.*Coverage.*Efficiency.*Satisfaction",
            "flags": "s"
          },
          {
            "id": "has-skill-tag",
            "file": "feedback/skip-lint-in-dev-builder.md",
            "mustMatch": "dev-builder"
          },
          {
            "id": "has-failure-class",
            "file": "feedback/skip-lint-in-dev-builder.md",
            "mustMatch": "execution-lapse|skill-defect|unset"
          },
          {
            "id": "index-updated",
            "file": "feedback/FEEDBACK-INDEX.md",
            "mustMatch": "skip-lint-in-dev-builder"
          }
        ]
      }
    }
  ]
}
