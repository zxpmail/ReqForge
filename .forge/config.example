# Forge configuration
# Priority: project .forge/config > global ~/.forge/config > env var FORGE_MODE

# Uncomment to enable YOLO async write mode:
# FORGE_MODE=yolo

# Ecosystem cache: set to "off" to skip library cache lookup (no more forge-ecosystem search).
# Default (unset) = enabled — checks cache before Context7/WebSearch for library selection.
# FORGE_ECOSYSTEM=off
