{
  "hooks": {
    "PreCommit": {
      "run": ".claude\\hooks\\pre-commit-check.bat"
    },
    "BeforeCommand": {
      "run": ".claude\\hooks\\stop-gate.bat && .claude\\hooks\\detect-feedback-signal.bat"
    },
    "AfterCommand": {
      "run": ".claude\\hooks\\mark-review-needed.bat"
    },
    "PostCommit": {
      "run": ".claude\\hooks\\auto-push.bat"
    },
    "OnInit": {
      "run": ".claude\\hooks\\check-evolution.bat"
    }
  }
}
