{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "bash .claude/hooks/hallucination-gate.sh" }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "bash .claude/hooks/phase-exit-guard.sh" },
          { "type": "command", "command": "bash .claude/hooks/stop-gate.sh" },
          { "type": "command", "command": "bash .claude/hooks/retry-gate.sh" },
          { "type": "command", "command": "bash .claude/hooks/detect-feedback-signal.sh" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "bash .claude/hooks/memory-guard.sh" },
          { "type": "command", "command": "bash .claude/hooks/check-sync.sh" }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "bash .claude/hooks/mark-review-needed.sh" },
          { "type": "command", "command": "bash .claude/hooks/memory-check.sh" }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "bash .claude/hooks/check-evolution.sh" }
        ]
      }
    ]
  }
}
