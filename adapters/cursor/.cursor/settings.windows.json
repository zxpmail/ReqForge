{
  "hooks": {
    "PreToolUse": {
      "run": "cmd /c .cursor\rules\hooks\hallucination-gate.bat"
    },
    "PreCommit": {
      "run": "cmd /c .cursor\rules\hooks\pre-commit-check.bat"
    },
    "BeforeCommand": {},
    "AfterCommand": {
      "run": "cmd /c .cursor\rules\hooks\mark-review-needed.bat && cmd /c .cursor\rules\hooks\memory-check.bat"
    },
    "PostToolUse": {
      "run": "cmd /c .cursor\rules\hooks\memory-guard.bat"
    },
    "OnInit": {
      "run": "cmd /c .cursor\rules\hooks\check-evolution.bat"
    }
  }
}
