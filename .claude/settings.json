{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "sh core/hooks/hallucination-gate.sh"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "sh core/hooks/phase-exit-guard.sh && sh core/hooks/stop-gate.sh && sh core/hooks/retry-gate.sh && sh core/hooks/detect-feedback-signal.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "sh core/hooks/memory-guard.sh && sh core/hooks/check-sync.sh"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "sh core/hooks/mark-review-needed.sh && sh core/hooks/memory-check.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "sh core/hooks/check-evolution.sh"
          }
        ]
      }
    ]
  }
}
