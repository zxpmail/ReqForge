{
  "hooks": {
    "PreCommit": {
      "run": "core\\hooks\\pre-commit-check.bat"
    },
    "BeforeCommand": {
      "run": "core\\hooks\\stop-gate.bat"
    },
    "AfterCommand": {
      "run": "core\\hooks\\mark-review-needed.bat && core\\hooks\\memory-check.bat"
    },
    "PostToolUse": {
      "run": "core\\hooks\\context-compaction.bat && core\\hooks\\check-sync.bat"
    },
    "OnInit": {
      "run": "core\\hooks\\check-evolution.bat"
    }
  }
}
