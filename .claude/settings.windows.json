{
  "hooks": {
    "PreToolUse": {
      "run": "core\\hooks\\hallucination-gate.bat"
    },
    "PreCommit": {
      "run": "core\\hooks\\pre-commit-check.bat"
    },
    "BeforeCommand": {
      "run": "core\\hooks\\stop-gate.bat && core\\hooks\\detect-feedback-signal.bat"
    },
    "AfterCommand": {
      "run": "core\\hooks\\mark-review-needed.bat && core\\hooks\\memory-check.bat"
    },
    "PostToolUse": {
      "run": "core\\hooks\\context-compaction.bat && core\\hooks\\check-sync.bat && core\\hooks\\check-handoff.bat"
    },
    "PostCommit": {
      "run": "core\\hooks\\auto-push.bat"
    },
    "OnInit": {
      "run": "core\\hooks\\check-evolution.bat"
    }
  }
}
